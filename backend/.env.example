# Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Will fallback to built-in verified in-memory store if MongoDB server is offline)
MONGO_URI=mongodb://localhost:27017/mgmu_iict_chatbot

# Primary AI Configuration (Supports Gemini, OpenAI, or custom REST APIs)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# College External APIs Integration Layer
PRIMARY_API_URL=https://api.mgmu.ac.in/iict/v1
PRIMARY_API_KEY=

FALLBACK_API_URL=https://fallback-api.mgmu.ac.in/iict/v1
FALLBACK_API_KEY=

# Local Verification & Anti-Hallucination Controls
STRICT_GROUNDING=true
ENABLE_MOCK_FALLBACK=true

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:5173
